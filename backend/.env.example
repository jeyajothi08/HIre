# Server Configuration
# Note: macOS ControlCenter/AirPlay reserves port 5000 by default, so 5001 is used
PORT=5001
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration (Provide real MongoDB URI when ready)
# Example for local: mongodb://127.0.0.1:27017/hirehub
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hirehub?retryWrites=true&w=majority
MONGO_URI=
