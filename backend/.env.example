# Server Configuration
# Note: macOS ControlCenter/AirPlay reserves port 5000 by default, so 5001 is used
PORT=5001
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration (Provide real MongoDB URI when ready)
# Example for local: mongodb://127.0.0.1:27017/hirehub
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hirehub?retryWrites=true&w=majority
MONGO_URI=

# In-Memory Database (Local Development Only)
# Explicitly spin up an isolated in-memory MongoDB instance for local testing without external MongoDB.
# Strictly prohibited in production.
USE_MEMORY_DB=false
ALLOW_DEV_MEMORY_FALLBACK=false

# Authentication Configuration
# Provide a strong 64-character secret in production
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Account Provisioning (for npm run seed:admin)
ADMIN_EMAIL=admin@hirehub.dev
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NAME=HireHub Administrator

# Job Moderation Feature Flag
# When 'true', employer job posts require admin approval before appearing in public listings
JOB_MODERATION_ENABLED=false

# Storage Configuration
# HireHub uses an abstracted StorageService.
# STORAGE_PROVIDER options: 'local' (default) or 's3' (STORAGE_DRIVER supported as alias)
STORAGE_PROVIDER=local
STORAGE_DRIVER=local

# Local Private Storage Path (relative to backend or absolute path)
# Default: ./storage/private/resumes (strictly outside publicly served static roots)
LOCAL_STORAGE_PATH=./storage/private/resumes

# AWS S3 / Object Storage Configuration (Optional, when STORAGE_PROVIDER=s3)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# S3_BUCKET=hirehub-private-resumes
# AWS_S3_BUCKET=hirehub-private-resumes
# AWS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com # Optional for MinIO / Cloudflare R2

# Email Alert Configuration (Optional)
# EMAIL_PROVIDER options: 'none' (default) or 'smtp'
EMAIL_PROVIDER=none
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=HireHub Alerts <no-reply@hirehub.dev>


